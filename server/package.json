{
    "name": "magic-sso-server",
    "version": "1.4.2",
    "private": true,
    "description": "SSO server with magic link authentication",
    "license": "GPL-3.0-or-later",
    "author": "Wojciech Polak",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magic-link-sso/magic-sso.git",
        "directory": "server"
    },
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "build": "pnpm --filter @magic-link-sso/config-core build && tsc -p tsconfig.json",
        "dev": "pnpm --filter @magic-link-sso/config-core build && node --watch --import tsx src/main.ts",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "start": "node dist/main.js",
        "test": "pnpm --filter @magic-link-sso/config-core build && vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "pnpm --filter @magic-link-sso/config-core build && tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/formbody": "^8.0.2",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/view": "^11.1.1",
        "@magic-link-sso/config-core": "workspace:*",
        "dotenv": "^17.4.2",
        "ejs": "^5.0.2",
        "fastify": "^5.12.5",
        "ioredis": "^5.11.1",
        "jose": "^6.2.12",
        "nodemailer": "^9.1.1",
        "pino-pretty": "^13.1.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/ejs": "^3.1.5",
        "@types/node": "^24.13.5",
        "@types/nodemailer": "^8.0.2",
        "@vitest/coverage-v8": "^4.1.11",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=24.15.0"
    }
}
