{
    "name": "example-app-fastify",
    "version": "1.4.2",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "node --watch --import tsx src/main.ts",
        "format": "oxfmt package.json tsconfig.json .env.example README.md src tests",
        "format:check": "oxfmt --check package.json tsconfig.json .env.example README.md src tests",
        "lint": "oxlint src tests",
        "start": "node dist/main.js",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.typecheck.json"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/formbody": "^8.0.2",
        "@magic-link-sso/config-core": "workspace:*",
        "@magic-link-sso/core": "workspace:*",
        "dotenv": "^17.4.2",
        "fastify": "^5.12.4",
        "magic-sso-example-ui": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.9.5",
        "jose": "^6.2.8",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=24.15.0"
    }
}
