{
    "name": "@magic-link-sso/core",
    "version": "1.4.2",
    "description": "Framework-agnostic authentication primitives for Magic Link SSO",
    "keywords": [
        "auth",
        "jwt",
        "magic-link",
        "sso",
        "ssr"
    ],
    "homepage": "https://github.com/magic-link-sso/magic-sso#readme",
    "bugs": {
        "url": "https://github.com/magic-link-sso/magic-sso/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Wojciech Polak"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magic-link-sso/magic-sso.git",
        "directory": "packages/core"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "format": "oxfmt package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts src test",
        "format:check": "oxfmt --check package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts src test",
        "lint": "oxlint src test",
        "test": "pnpm run build && vitest run",
        "typecheck": "tsc -p tsconfig.typecheck.json"
    },
    "dependencies": {
        "jose": "^6.2.12"
    },
    "devDependencies": {
        "@types/node": "^25.9.7",
        "esbuild": "0.28.2",
        "miniflare": "4.20260730.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=24.15.0"
    }
}
